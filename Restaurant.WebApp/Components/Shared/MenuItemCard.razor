<div class="card h-100 menu-item-card @(Item.IsAvailable ? "" : "is-unavailable")">
    <div class="menu-item-media">
        <img src="@GetImageSource()"
             alt="Ảnh món @Item.Name"
             class="menu-item-img"
             loading="lazy"
             decoding="async"
             onerror="this.onerror=null;this.src='/images/menu/bun-bo-hue.jpg';" />
        <span class="category-chip">@Item.CategoryName</span>
        @if (!Item.IsAvailable)
        {
            <span class="sold-out-badge">Tạm hết</span>
        }
    </div>

    <div class="card-body d-flex flex-column p-3">
        <h4 class="card-title text-truncate" title="@Item.Name">@Item.Name</h4>
        <p class="card-text flex-grow-1">@Item.Description</p>
        <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
            <span class="price-tag">@Item.Price.ToString("N0")₫</span>
            <button class="btn btn-primary btn-sm px-3"
                    @onclick="HandleSelect"
                    disabled="@(IsDisabled || !Item.IsAvailable)">
                @(Item.IsAvailable ? "+ Thêm vào đĩa" : "Hết món")
            </button>
        </div>
        @if (IsDisabled && Item.IsAvailable)
        {
            <small class="text-muted text-center mt-1" style="font-size:0.75rem;">
                (Vui lòng chọn bàn ở trên để thêm món)
            </small>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public MenuItem Item { get; set; } = default!;

    [Parameter]
    public bool IsDisabled { get; set; } = false;

    [Parameter]
    public EventCallback<MenuItem> OnSelect { get; set; }

    private async Task HandleSelect()
    {
        if (OnSelect.HasDelegate)
        {
            await OnSelect.InvokeAsync(Item);
        }
    }

    private string GetImageSource()
    {
        if (!string.IsNullOrWhiteSpace(Item.ImageUrl))
            return Item.ImageUrl;

        return Item.Name.Trim().ToLowerInvariant() switch
        {
            "nước ép chanh dây" => "/images/menu/nuoc-ep-chanh-day.jpg",
            "trà cung đình huế" => "/images/menu/tra-cung-dinh.jpg",
            "bánh bèo chén" => "/images/menu/banh-beo.jpg",
            "bánh lọc trần" => "/images/menu/banh-bot-loc.jpg",
            "bánh nậm lá chuối" => "/images/menu/banh-nam.jpg",
            "bò lá lốt" => "/images/menu/bo-la-lot.jpg",
            "cơm hến" => "/images/menu/com-hen.jpg",
            "nem lụi nướng" => "/images/menu/nem-lui.jpg",
            "bún bò huế" => "/images/menu/bun-bo-hue.jpg",
            "bún giò heo" => "/images/menu/bun-gio-heo.jpg",
            "phở huế đặc biệt" => "/images/menu/pho-hue.jpg",
            _ => "/images/menu/bun-bo-hue.jpg"
        };
    }
}
