    <meta name="description" content="Nhà hàng đặc sản Huế - Đặt bàn và gọi món trực tuyến" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Restaurant.WebApp.styles.css"]" />
