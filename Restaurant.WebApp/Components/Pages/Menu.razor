@page "/menu"
@inject ViewMenuItemsUseCase ViewMenuItemsUseCase
@inject IDiningTableRepository TableRepository
@inject PlaceTableOrderUseCase PlaceTableOrderUseCase
@inject ScopedOrderState OrderState
@rendermode InteractiveServer

<PageTitle>Thực Đơn Món Huế - Đặt & Gọi Món</PageTitle>

<div class="page-header mb-4">
    <div class="section-label">TINH HOA ẨM THỰC HUẾ</div>
    <h1 class="mb-1">🍜 Thực Đơn Món Huế</h1>
    <p class="page-subtitle mb-0">Hương vị chuẩn kinh kỳ xưa, chế biến công phu, chuẩn vị truyền thống.</p>
</div>

<!-- BƯỚC 1: Chọn bàn (Bắt buộc theo chuẩn nghiệp vụ) -->
<div class="table-selector-banner @(selectedTableId == 0 ? "banner-warning" : "banner-success") shadow-sm mb-4">
    @if (selectedTableId == 0)
    {
        <div class="d-flex align-items-center flex-wrap gap-2 w-100">
            <span class="banner-title-text">
                ⚠️ <strong>Bước 1: Vui lòng chọn bàn đang ngồi để gọi món:</strong>
            </span>
            <div class="table-pills-list d-flex flex-wrap gap-2 my-1">
                @if (availableTables != null && availableTables.Any())
                {
                    @foreach (var t in availableTables)
                    {
                        <button class="table-pill-btn" @onclick="() => SelectTable(t)">
                            🪑 Bàn @t.TableNumber <span class="pill-cap">(@t.Capacity chỗ)</span>
                        </button>
                    }
                }
                else
                {
                    <span class="no-table-alert">
                        Chưa có bàn nào đang mở. Quản trị viên cần vào <a href="/admin/tables" class="text-decoration-underline fw-bold">Sơ Đồ Bàn</a> bấm <strong>"Mở Bàn"</strong> trước.
                    </span>
                }
            </div>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 w-100">
            <div class="d-flex align-items-center gap-2">
                <span class="active-table-badge">✅ Đang gọi món</span>
                <span class="active-table-info">
                    <strong>Bàn số @selectedTable?.TableNumber</strong> (Sức chứa: @selectedTable?.Capacity khách)
                </span>
            </div>
            <button class="table-btn-change" @onclick="() => { selectedTableId = 0; selectedTable = null; OrderState.Clear(); }">
                🔄 Chọn lại bàn khác
            </button>
        </div>
    }
</div>

<div class="row g-4">
    <!-- CỘT TRÁI: DANH SÁCH MÓN ĂN & BỘ LỌC -->
    <div class="col-lg-8">
        @if (menuItems == null)
        {
            <div class="loading-box">
                <div class="spinner-border text-danger" role="status"></div>
                <p class="mt-2">Đang tải danh sách món Huế...</p>
            </div>
        }
        else
        {
            <!-- Tabs danh mục -->
            <div class="category-tabs mb-4">
                <button class="cat-tab @(activeCategory == 0 ? "active" : "")" @onclick="() => activeCategory = 0">
                    ✨ Tất cả món (@menuItems.Count())
                </button>
                @foreach (var cat in categories)
                {
                    <button class="cat-tab @(activeCategory == cat.Key ? "active" : "")"
                            @onclick="() => activeCategory = cat.Key">
                        @GetCategoryIcon(cat.Key) @cat.Value
                    </button>
                }
            </div>

            <!-- Grid món ăn sử dụng Component MenuItemCard tái sử dụng (K3.1) -->
            <div class="row g-3">
                @foreach (var item in filteredItems)
                {
                    <div class="col-md-6">
                        <MenuItemCard Item="@item"
                                      IsDisabled="@(selectedTableId == 0)"
                                      OnSelect="AddToOrder" />
                    </div>
                }
            </div>
        }
    </div>

    <!-- CỘT PHẢI: GIỎ MÓN TẠI BÀN (Sử dụng Component OrderSummaryPanel tái sử dụng - K3.1) -->
    <div class="col-lg-4">
        <OrderSummaryPanel TableId="@selectedTableId"
                           TableNumber="@selectedTable?.TableNumber"
                           Items="@OrderState.SelectedItems"
                           IsOrdering="@isOrdering"
                           ErrorMessage="@orderError"
                           SuccessMessage="@orderSuccess"
                           OnConfirm="ConfirmOrder"
                           OnClear="ClearOrder"
                           OnQuantityChanged="HandleQuantityChanged" />
    </div>
</div>

@code {
    private IEnumerable<MenuItem>? menuItems;
    private IEnumerable<DiningTable>? availableTables;
    private Dictionary<int, string> categories = new();
    private int activeCategory = 0;
    private int selectedTableId = 0;
    private DiningTable? selectedTable;
    private string orderError = "";
    private string orderSuccess = "";
    private bool isOrdering = false;

    private IEnumerable<MenuItem> filteredItems =>
        menuItems == null ? Enumerable.Empty<MenuItem>() :
        activeCategory == 0 ? menuItems : menuItems.Where(m => m.CategoryId == activeCategory);

    protected override async Task OnInitializedAsync()
    {
        menuItems = await ViewMenuItemsUseCase.ExecuteAsync();
        var allTables = await TableRepository.GetTablesAsync();
        availableTables = allTables.Where(t => t.IsOccupied);

        if (menuItems != null)
        {
            categories = menuItems
                .Where(m => m.Category != null)
                .GroupBy(m => m.CategoryId)
                .ToDictionary(g => g.Key, g => g.First().Category?.Name ?? "");
        }
    }

    private void SelectTable(DiningTable table)
    {
        selectedTableId = table.TableId;
        selectedTable = table;
        OrderState.Clear();
        orderError = "";
        orderSuccess = "";
    }

    private void AddToOrder(MenuItem item)
    {
        if (selectedTableId == 0) return;
        OrderState.AddItem(item, 1);
        orderSuccess = "";
    }

    private void HandleQuantityChanged((TableOrderLine Line, int Delta) args)
    {
        args.Line.Quantity += args.Delta;
        if (args.Line.Quantity <= 0)
            OrderState.SelectedItems.Remove(args.Line);
        StateHasChanged();
    }

    private void ClearOrder()
    {
        OrderState.Clear();
        orderSuccess = "";
        orderError = "";
    }

    private async Task ConfirmOrder()
    {
        if (selectedTableId == 0 || !OrderState.SelectedItems.Any()) return;
        isOrdering = true;
        orderError = "";
        orderSuccess = "";

        try
        {
            // Gộp toàn bộ danh sách món vào 1 lần gọi duy nhất (atomic) - tránh cross-table bug
            var items = OrderState.SelectedItems
                .Select(line => (line.ItemId, line.Price, line.Quantity))
                .ToList();
            await PlaceTableOrderUseCase.ExecuteAsync(selectedTableId, items);
            orderSuccess = $"Đã gửi gọi món thành công cho Bàn {selectedTable?.TableNumber}! Nhà bếp đang chuẩn bị.";
            OrderState.Clear();
        }
        catch (Exception ex)
        {
            orderError = "Lỗi khi gửi gọi món: " + ex.Message;
        }
        finally { isOrdering = false; }
    }

    private string GetCategoryIcon(int categoryId) => categoryId switch
    {
        1 => "🍜",
        2 => "🥟",
        3 => "🍛",
        4 => "🍧",
        _ => "🍽️"
    };
}
