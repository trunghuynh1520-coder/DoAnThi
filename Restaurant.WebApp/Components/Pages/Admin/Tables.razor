@page "/admin/tables"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject IDiningTableRepository TableRepository
@inject CloseTableOrderUseCase CloseTableOrderUseCase
@inject ExportBillUseCase ExportBillUseCase
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Sơ Đồ Bàn - Quản Trị Thu Ngân | Nhà Hàng Món Huế</PageTitle>

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <div class="section-label">HỆ THỐNG ĐIỀU PHỐI</div>
        <h1 class="mb-1">🪑 Sơ Đồ Bàn & Trạng Thái</h1>
        <p class="page-subtitle mb-0">Theo dõi khách tại chỗ, mở bàn mới và đóng hóa đơn thanh toán theo thời gian thực.</p>
    </div>
    <div>
        <button class="btn btn-outline-hue" @onclick="LoadTables" disabled="@isLoading">
            🔄 Làm mới sơ đồ
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger shadow-sm">⚠️ @errorMessage</div>
}
@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success shadow-sm">✅ @successMessage</div>
}

@if (tables == null)
{
    <div class="loading-box">
        <div class="spinner-border text-danger" role="status"></div>
        <p class="mt-2">Đang tải sơ đồ bàn từ cơ sở dữ liệu...</p>
    </div>
}
else
{
    <!-- THỐNG KÊ NHANH -->
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="stat-card">
                <div class="stat-icon">🪑</div>
                <div class="stat-content">
                    <div class="stat-number">@tables.Count()</div>
                    <div class="stat-label">Tổng số bàn</div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="stat-card stat-occupied">
                <div class="stat-icon">🔴</div>
                <div class="stat-content">
                    <div class="stat-number">@tables.Count(t => t.IsOccupied)</div>
                    <div class="stat-label">Đang có khách ngồi</div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="stat-card stat-free">
                <div class="stat-icon">🟢</div>
                <div class="stat-content">
                    <div class="stat-number">@tables.Count(t => !t.IsOccupied)</div>
                    <div class="stat-label">Bàn sẵn sàng đón khách</div>
                </div>
            </div>
        </div>
    </div>

    <!-- SƠ ĐỒ BÀN (Sử dụng TableStatusBadge Component tái sử dụng - K3.1) -->
    <div class="table-map-container">
        <div class="row g-3">
            @foreach (var table in tables.OrderBy(t => t.TableNumber))
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="card table-map-card @(table.IsOccupied ? "table-card-occupied" : "table-card-free") h-100">
                        <div class="card-body p-3 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="table-avatar">@(table.IsOccupied ? "👥" : "🪑")</span>
                                    <TableStatusBadge IsOccupied="@table.IsOccupied"
                                                      OccupiedText="Đang phục vụ"
                                                      FreeText="Bàn trống" />
                                </div>
                                <h4 class="table-title mb-1">Bàn @table.TableNumber</h4>
                                <div class="table-capacity-text">
                                    <span>👥 Sức chứa: <strong>@table.Capacity người</strong></span>
                                </div>
                            </div>

                            <div class="table-action-box mt-3 d-flex flex-column gap-2">
                                @if (!table.IsOccupied)
                                {
                                    <button class="btn btn-success btn-sm w-100 py-2 shadow-sm"
                                            @onclick="() => OpenTable(table.TableId)"
                                            disabled="@isLoading">
                                        ✨ Mở Bàn (Đón khách)
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-outline-hue btn-sm w-100 py-1"
                                            @onclick="() => DownloadInvoice(table.TableId, table.TableNumber)"
                                            disabled="@isLoading">
                                        📄 Xuất Phiếu Thanh Toán
                                    </button>
                                    <button class="btn btn-danger btn-sm w-100 py-2 shadow-sm"
                                            @onclick="() => CloseBill(table.TableId)"
                                            disabled="@isLoading">
                                        🧾 Đóng Bill & Thanh Toán
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="instruction-box mt-4">
        <div class="instruction-icon">💡</div>
        <div class="instruction-text">
            <strong>Hướng dẫn quy trình nghiệp vụ:</strong><br />
            1. Khi khách vào nhà hàng hoặc nhận bàn đã đặt: Nhấn <strong>✨ Mở Bàn (Đón khách)</strong> để kích hoạt bàn.<br />
            2. Khách hàng hoặc phục vụ viên vào trang <strong>Menu Món Huế</strong> chọn bàn đó để đặt món.<br />
            3. Thu ngân có thể nhấn <strong>📄 Xuất Phiếu Thanh Toán</strong> để tải hóa đơn định dạng Text/CSV chi tiết (Tính năng nâng cao K4.3).<br />
            4. Sau khi dùng bữa xong: Nhấn <strong>🧾 Đóng Bill & Thanh Toán</strong> để hoàn tất và trả bàn về trạng thái trống.
        </div>
    </div>
}

@code {
    private IEnumerable<DiningTable>? tables;
    private string errorMessage = "";
    private string successMessage = "";
    private bool isLoading = false;

    protected override async Task OnInitializedAsync() => await LoadTables();

    private async Task LoadTables()
    {
        isLoading = true;
        errorMessage = "";
        try
        {
            tables = await TableRepository.GetTablesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi khi lấy dữ liệu bàn: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenTable(int tableId)
    {
        isLoading = true;
        errorMessage = "";
        successMessage = "";
        try
        {
            await TableRepository.OpenTableAsync(tableId);
            var table = tables?.FirstOrDefault(t => t.TableId == tableId);
            successMessage = $"Đã mở Bàn {table?.TableNumber} thành công! Khách hàng có thể bắt đầu gọi món.";
            await LoadTables();
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi khi mở bàn: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DownloadInvoice(int tableId, string tableNumber)
    {
        isLoading = true;
        errorMessage = "";
        try
        {
            string invoiceContent = await ExportBillUseCase.ExecuteAsync(tableId);
            var bytes = System.Text.Encoding.UTF8.GetBytes(invoiceContent);
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"HoaDon_Ban_{tableNumber}_{DateTime.Now:yyyyMMdd_HHmmss}.txt";

            await JSRuntime.InvokeVoidAsync("downloadFileFromBase64", fileName, base64);
            successMessage = $"Đã xuất hóa đơn cho Bàn {tableNumber} thành công!";
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi khi xuất hóa đơn: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CloseBill(int tableId)
    {
        isLoading = true;
        errorMessage = "";
        successMessage = "";
        try
        {
            await CloseTableOrderUseCase.ExecuteAsync(tableId);
            var table = tables?.FirstOrDefault(t => t.TableId == tableId);
            successMessage = $"Đã thanh toán và đóng hóa đơn Bàn {table?.TableNumber}. Bàn đã trở về trạng thái trống.";
            await LoadTables();
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi khi đóng hóa đơn: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
