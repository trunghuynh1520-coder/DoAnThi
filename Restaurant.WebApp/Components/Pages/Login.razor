@page "/login"
@layout CustomerLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Đăng nhập - Nhà Hàng Món Huế</PageTitle>

@if (Request.Query.ContainsKey("error"))
{
    <div class="auth-error">Sai tên đăng nhập hoặc mật khẩu. Vui lòng thử lại.</div>
}

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-header">
            <div class="login-logo">🍜</div>
            <h1>Nhà Hàng Món Huế</h1>
            <p>Đăng nhập khách hàng hoặc quản trị viên</p>
        </div>
        <form method="post" action="/login" class="login-form">
            <AntiforgeryToken />
            <div class="form-group">
                <label>Tên đăng nhập</label>
                <input type="text" id="login-username" name="username" class="form-input" placeholder="Nhập tên đăng nhập" required />
            </div>
            <div class="form-group">
                <label>Mật khẩu</label>
                <input type="password" id="login-password" name="password" class="form-input" placeholder="Nhập mật khẩu" required />
            </div>
            <div class="demo-account-buttons mb-3 d-flex gap-2">
                <button type="button" class="btn-demo-fill flex-grow-1" onclick="document.getElementById('login-username').value='admin'; document.getElementById('login-password').value='admin';">
                    👑 Quản trị (admin)
                </button>
                <button type="button" class="btn-demo-fill flex-grow-1" onclick="document.getElementById('login-username').value='user'; document.getElementById('login-password').value='user';">
                    👤 Khách (user)
                </button>
            </div>
            <p class="hint mb-3">Tài khoản demo kiểm thử hệ thống:<br />• Quản trị viên: <code>admin / admin</code><br />• Khách hàng: <code>user / user</code></p>
            <button type="submit" class="btn-login">Đăng nhập</button>
        </form>
    </div>
</div>

@code {
    [CascadingParameter] HttpContext? HttpContext { get; set; }
    HttpRequest Request => HttpContext!.Request;
}
